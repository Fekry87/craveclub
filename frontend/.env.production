VITE_API_URL=https://web-production-c3c32.up.railway.app/api/v1

# Reverb (real-time registrations).
# Railway terminates TLS at its edge, so the scheme and port are fixed for any
# Railway deployment and can live here.
VITE_REVERB_SCHEME=https
VITE_REVERB_PORT=443

# VITE_REVERB_HOST and VITE_REVERB_APP_KEY are deployment-specific and are NOT set
# here on purpose. Set them as env vars on the Railway frontend service — Vite reads
# any VITE_-prefixed variable from the build environment:
#
#   VITE_REVERB_HOST     the reverb service's public domain, no scheme
#                        (e.g. reverb-production-xxxx.up.railway.app)
#   VITE_REVERB_APP_KEY  must equal the backend service's REVERB_APP_KEY
#
# Do not commit placeholder values. A wrong key makes Reverb close the socket during
# the handshake, which the UI could only report as a mute "offline" — exactly the bug
# this file used to cause. With them unset, the app now logs what is missing instead.
