# ─────────────────────────────────────────────────────────
# CraveClubs — Production Environment
# ─────────────────────────────────────────────────────────
# Copy this to .env on your production server and fill in
# the values. Never commit the actual .env file.
# ─────────────────────────────────────────────────────────

APP_NAME=CraveClubs
APP_ENV=production
APP_KEY=              # Run: php artisan key:generate
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_TIMEZONE=UTC

BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────
LOG_CHANNEL=json
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Sentry Error Tracking ───────────────────────────────
SENTRY_LARAVEL_DSN=https://YOUR_DSN@sentry.io/PROJECT_ID
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Database ─────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=craveclubs
DB_USERNAME=craveclubs_user
DB_PASSWORD=

# ── Cache / Queue / Session ──────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=your-domain.com
SESSION_SECURE_COOKIE=true

# ── Redis ────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Broadcasting (Reverb) ────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=your-reverb-app-id
REVERB_APP_KEY=your-reverb-app-key
REVERB_APP_SECRET=your-reverb-app-secret
REVERB_HOST=your-domain.com
REVERB_PORT=8080
REVERB_SCHEME=https

# ── Mail ─────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-email-provider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Filesystem ───────────────────────────────────────────
FILESYSTEM_DISK=local

# ── App Versioning (mobile force-update) ─────────────────
MINIMUM_IOS_VERSION=1.0.0
MINIMUM_ANDROID_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
IOS_STORE_URL=https://apps.apple.com/app/your-app-id
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=your.app.id

# ── Frontend ─────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── Production Cache Commands ────────────────────────────
# Run these after deployment to optimize performance:
#   php artisan config:cache
#   php artisan route:cache
#   php artisan view:cache
#   php artisan event:cache
#
# To clear cached config during troubleshooting:
#   php artisan config:clear
#   php artisan route:clear
#   php artisan view:clear
#   php artisan event:clear
